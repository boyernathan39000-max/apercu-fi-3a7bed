# En-tetes de securite du site Flow Industrie.
# FICHIER GENERE. Ne pas modifier a la main : relancer
#   node "controles/genere_entetes.mjs"
# depuis 02-Versions/V3 - en cours. La CSP porte un hachage par script en
# ligne (73 scripts, 19 hachages distincts) : toute
# retouche d'une page change ces hachages.
<IfModule mod_headers.c>
  Header always set Content-Security-Policy "default-src 'self'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; connect-src 'self'; img-src 'self'; font-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'sha256-DajYMOsf9xuQ18/fhbhoU97FxIJigRNLJNfGbOc4DWU=' 'sha256-F4dVooUHYbeJVKo9ETOKojAk6opuhm/gjxGF6s1hCV0=' 'sha256-H/h23YL2979zcx0wUePQkxsVmetAAcgodoPHVkImszE=' 'sha256-I97PnIomfC+WstzZJumY0wVxm04XzrtNLKtuOYne1zY=' 'sha256-MNS/paDLjDaQkwt1u+kXeKXYno41+6v6PpOE3vsenKI=' 'sha256-N+XO8Cx05UwPxOwJboXyIai/KnD3xPkzActjR3sI6TA=' 'sha256-O5C0F69MNIUGkbRxANxPMxNjXpqsHy9zmhCb/3FpyaY=' 'sha256-RP8kBKxB3DQBVfwsa+Q/O5E0Xi7/aepl/NaGtfgnVx4=' 'sha256-TBx7U053A56zU0WbflYXpEfaOUDmyZK5Fxl/qmpCxHU=' 'sha256-UB8/CEtJqXLIvucd1Bsl+2giv1SDS6WNuO7UwfCBL9g=' 'sha256-b5ftziUCKrDlBRN6EldqlX7mmaIEawG89W7tQRPm/jM=' 'sha256-c9J1X8F/mkfIfmQxTYSgrDHBRIS06fiOVZIiEiQZays=' 'sha256-cMCBGO9ZtCgp/buhvRheU1u1rU/do/Z2P78fL+Pmq6g=' 'sha256-fN0GM3G/60S3aHgWo0wPI5bom0W0zzrAw1me9D6MLys=' 'sha256-itCo2jN4TXmz/xiOQn1lkD+zMJF+u+Xpr9ZeIJZaQjA=' 'sha256-ogMFA0l4i0mh32ZIINIR8QKW/3scyBTMLEE7CD7NPv0=' 'sha256-pqp9GPRYL+8tzdxusI6vZeym2GyBkolCu//PX1Tplkw=' 'sha256-pyFT4FwP5xi9kQCAFg3ELmjp+F2FjHZ6dozz1/O2YaY=' 'sha256-rrO8Kvm+mIh16I4ud6QZDFzvb3/Hfnr+AtxZUvzEA/4='; upgrade-insecure-requests"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set Permissions-Policy "accelerometer=(), camera=(), display-capture=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()"
  Header always unset X-Powered-By
  Header always unset Server
</IfModule>

ServerSignature Off

# Le traitement des formulaires : seuls contact.php et candidature.php repondent.
<FilesMatch "^(commun|config)\.php$">
  Require all denied
  <IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
  </IfModule>
</FilesMatch>

# HTTPS obligatoire. A DECOMMENTER une fois le certificat IONOS actif,
# et pas avant : sans certificat, cette redirection rend le site injoignable.
# <IfModule mod_rewrite.c>
#   RewriteEngine On
#   RewriteCond %{HTTPS} !=on
#   RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]
# </IfModule>
